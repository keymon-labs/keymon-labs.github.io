  "outcomes": {
    "no_ball": {
      "say": {"en": "Throw... what?", "es": "¿Lanzar... qué?"},
      "text": {
        "en": "The kid throws pure air. Very strong air! Pick up the ball first, then throw it.",
        "es": "El niño lanza aire. ¡Aire muy fuerte! Primero coge la pelota y después lánzala."
      },
      "beats": [{"pose": "throw"}, [{"pose": "shrug"}, {"fx": "smoke", "at": "kid"}, {"sound": "bad"}]]
    },
    "nothing_to_eat": {
      "say": {"en": "Eat... my shoe?", "es": "¿Comer... mi zapato?"},
      "text": {
        "en": "There's nothing in your hands to eat. Pick up the ball first!",
        "es": "No tienes nada en las manos para comer. ¡Primero coge la pelota!"
      },
      "beats": [[{"pose": "shrug"}, {"fx": "question", "at": "kid"}, {"sound": "bad"}]]
    },
    "frog_runs": {
      "say": {"en": "Come here, froggy!", "es": "¡Ven aquí, ranita!"},
      "set": {"frog": "away"},
      "text": {
        "en": "The frog hops away. Frogs are fast and a bit rude. Try another plan.",
        "es": "La rana se va saltando. Las ranas son rápidas y un poco maleducadas. Prueba otro plan."
      },
      "beats": [
        {"pose": "run"},
        {"say": {"en": "Nope!", "es": "¡Ni hablar!"}, "actor": "frog"},
        {"move": "frog", "to": "away", "dur": 800, "arc": 160},
        {"pose": "shrug"}
      ]
    },
    "ate_ball": {
      "say": {"en": "Yum!", "es": "¡Ñam!"},
      "set": {"ball": "mouth"},
      "text": {
        "en": "You ate the ball! Crunchy. The frog is still there, laughing. A new ball rolls in.",
        "es": "¡Te comiste la pelota! Crujiente. La rana sigue ahí, riéndose. Llega rodando una pelota nueva."
      },
      "beats": [
        {"move": "ball", "to": "hand", "dur": 450, "arc": 70, "spin": 360},
        [{"pose": "eat"}, {"move": "ball", "to": "mouth", "dur": 400, "delay": 250}],
        {"fx": "yum", "at": "kid"},
        [{"pose": "croak", "actor": "frog"}, {"say": {"en": "Ha ha, ribbit!", "es": "¡Ja ja, croac!"}, "actor": "frog"}]
      ]
