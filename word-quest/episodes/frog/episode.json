        {"move": "ball", "to": "net", "dur": 220},
        [{"move": "ball", "to": "hoopside", "dur": 500, "arc": 60, "spin": -360}, {"sound": "boing"}],
        [{"pose": "cheer"}, {"fx": "sparkle", "at": "basket"}],
        {"say": {"en": "Is that all?", "es": "¿Eso es todo?"}, "actor": "frog"}
      ]
    },
