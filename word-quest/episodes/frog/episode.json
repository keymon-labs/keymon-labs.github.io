  "tutorial": [
    {
      "text": {
        "en": "Hi! Here's how to play. Write ONE sentence on paper, take a photo, and the story does what you wrote.",
        "es": "¡Hola! Así se juega. Escribe UNA frase en papel, haz una foto y la historia hace lo que escribiste."
      }
    },
    {
      "text": {
        "en": "Your sentence must use the words \"throw\" and \"through\". The mission: smash the frog with the ball!",
        "es": "Tu frase debe usar las palabras \"lanza\" y \"a través\". La misión: ¡aplastar a la rana con la pelota!"
      }
    },
    {
      "text": {
        "en": "If there are mistakes, fix them on paper and take a new photo. Every word written right wins a coin 🪙.",
        "es": "Si hay errores, arréglalos en el papel y haz otra foto. Cada palabra bien escrita gana una moneda 🪙."
      }
    },
    {
      "text": {"en": "Example 1: \"Throw the ball.\" Let's see…", "es": "Ejemplo 1: \"Lanza la pelota.\" A ver…"},
      "demo": {"sentence": {"en": "Throw the ball.", "es": "Lanza la pelota."}, "expect": "no_ball"}
    },
    {
      "text": {"en": "Example 2: \"Pick up the ball and eat it.\" Hmm…", "es": "Ejemplo 2: \"Coge la pelota y cómela.\" Mmm…"},
      "demo": {"sentence": {"en": "Pick up the ball and eat it.", "es": "Coge la pelota y cómela."}, "expect": "ate_ball"}
    },
    {
      "text": {
        "en": "Example 3: pick up the ball, throw it through the basket, and make it bounce on the frog.",
        "es": "Ejemplo 3: coge la pelota, lánzala a través de la canasta y haz que rebote en la rana."
      },
      "demo": {
        "sentence": {
          "en": "Pick up the ball and throw it through the basket. It bounces on the frog.",
          "es": "Coge la pelota y lánzala a través de la canasta. Rebota en la rana."
        },
        "expect": "win"
      }
    },
    {
      "text": {
        "en": "Now it's your turn! Write your own sentence and tap the camera. First photo with no mistakes = 3 stars.",
        "es": "¡Ahora te toca! Escribe tu frase y toca la cámara. Primera foto sin errores = 3 estrellas."
      }
    }
  ]
}
