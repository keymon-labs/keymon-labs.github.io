        "es": "La rana salta y la esquiva. ¡Qué presumida! Quizá la canasta pueda ayudar."
      },
      "beats": [
        {"move": "ball", "to": "hand", "dur": 450, "arc": 70, "spin": 360},
        [
          {"pose": "throw"},
          {"move": "ball", "to": "frog", "dur": 600, "arc": 120, "spin": 360, "delay": 450},
          {"pose": "leap", "actor": "frog", "delay": 600}
