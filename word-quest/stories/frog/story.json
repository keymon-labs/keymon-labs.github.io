{
  "id": "frog",
  "tutorial": [
    {
      "say": {
        "en": "Hi! Let's learn how to play. Write one sentence on paper, take a photo, and watch what happens.",
        "es": "¡Hola! Vamos a aprender. Escribe una frase en papel, haz una foto y mira qué pasa."
      }
    },
    {
      "say": {
        "en": "Your sentence must use the words throw and through. Our mission: smash the frog!",
        "es": "Tu frase debe usar las palabras lanza y a través. ¡Misión: aplastar a la rana!"
      }
    },
    {
      "say": {
        "en": "Example 1: 'throw the ball'. Nothing happens, because you must pick up the ball first.",
        "es": "Ejemplo 1: 'lanza la pelota'. No pasa nada, porque primero hay que coger la pelota."
      },
      "demo": {
        "sentence": {
          "en": "throw the ball",
          "es": "lanza la pelota"
        },
        "expect": "no_pick"
      }
    },
    {
      "say": {
        "en": "Example 2: 'pick the ball and eat it'. It works, but the frog is still there.",
        "es": "Ejemplo 2: 'coge la pelota y cómela'. Funciona, pero la rana sigue ahí."
      },
      "demo": {
        "sentence": {
          "en": "pick the ball and eat it",
          "es": "coge la pelota y comela"
        },
        "expect": "ate_ball"
      }
    },
    {
      "say": {
        "en": "Example 3: pick the ball, throw it through the basket, and it bounces into the frog. Smash!",
        "es": "Ejemplo 3: coge la pelota, lánzala a través de la canasta, y rebota en la rana. ¡Zas!"
      },
      "demo": {
        "sentence": {
          "en": "pick the ball and throw it through the basket. It bounces into the frog.",
          "es": "coge la pelota y lanzala a traves de la canasta. rebota en la rana."
        },
        "expect": "win"
      }
    },
    {
      "say": {
        "en": "Now it's your turn! Take a photo of your sentence.",
        "es": "¡Ahora te toca! Haz una foto de tu frase."
      }
    }
  ],
