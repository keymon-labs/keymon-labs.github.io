{
  "stories": [
    {
      "id": "frog",
      "tutorial": true,
      "title": { "en": "Smash the Frog", "es": "Aplasta a la rana" },
      "mission": { "en": "Smash the frog!", "es": "¡Aplasta a la rana!" },
      "intro": {
        "en": "The frog sits under the basket. Write one sentence on paper to smash it.",
        "es": "La rana está debajo de la canasta. Escribe una frase en papel para aplastarla."
      },
      "target": { "en": ["throw", "through"], "es": ["lanza", "a través"] },
      "groups": {
        "en": {
          "pick": ["pick", "picks", "picked", "grab", "take", "get", "lift", "collect"],
          "throw": ["throw", "throws", "threw", "toss", "tosses", "tossed"],
          "basket": ["basket", "hoop", "net"],
          "through": ["through"],
          "frog": ["frog", "frogs"],
          "eat": ["eat", "eats", "ate", "swallow", "swallows"],
          "catch": ["catch", "catches", "chase", "chases"],
          "bounce": ["bounce", "bounces", "bounced", "hit", "hits", "smash", "smashes", "lands", "land"]
        },
        "es": {
          "pick": ["coge", "recoge", "toma", "agarra", "levanta", "coger", "tomar", "agarrar", "levantar", "recoger"],
          "throw": ["lanza", "lanzar", "lanzas", "tira", "tirar", "tiras"],
          "basket": ["canasta", "canastas", "cesta", "aro"],
          "through": ["traves"],
          "frog": ["rana", "ranas"],
          "eat": ["come", "comer", "comes", "traga", "tragar", "muerde", "morder"],
          "catch": ["atrapa", "atrapar", "atrapas", "persigue", "perseguir", "persigues"],
          "bounce": ["rebota", "rebotar", "rebotas", "golpea", "golpear", "aplasta", "aplastar", "cae", "caer"]
        }
      },
      "rules": [
        { "if": ["throw"], "held": false, "outcome": "no_pick" },
        { "if": ["eat"], "held": false, "outcome": "no_pick" },
        { "if": ["catch", "frog"], "outcome": "frog_runs" },
        { "if": ["eat"], "outcome": "ate_ball" },
        { "if": ["throw", "basket", "bounce", "frog"], "outcome": "win" },
        { "if": ["throw", "basket"], "outcome": "basket_only" },
        { "if": ["throw", "frog"], "outcome": "frog_runs" },
        { "if": ["throw"], "outcome": "throw_miss" },
        { "if": ["pick"], "outcome": "picked" }
      ],
      "outcomes": {
        "no_pick": {
          "effects": { "kid": "shrug", "ballAt": "idle" },
          "sound": "bad",
          "text": {
            "en": "You need to pick up the ball first. Write a sentence that picks it up, then throws it.",
            "es": "Primero tienes que coger la pelota. Escribe una frase que la coja y después la lance."
          }
        },
        "frog_runs": {
          "effects": { "frog": "away", "kid": "shrug" },
          "sound": "bad",
          "text": {
            "en": "The frog hops away! Frogs are fast. Try another plan.",
            "es": "¡La rana salta y se va! Las ranas son rápidas. Prueba otro plan."
          }
        },
        "ate_ball": {
          "effects": { "ballGone": true, "ballHeld": false, "ballAt": "gone", "kid": "dance" },
          "sound": "pop",
          "text": {
            "en": "Yum! You ate the ball. The frog is still there. A new ball rolls in for your next try.",
            "es": "¡Mmm! Te comiste la pelota. La rana sigue ahí. Una pelota nueva rueda para la siguiente vez."
          }
        },
        "picked": {
          "effects": { "ballHeld": true, "ballAt": "held", "kid": "idle" },
          "sound": "pop",
          "text": { "en": "You picked up the ball. Now throw it!", "es": "Cogiste la pelota. ¡Ahora lánzala!" }
        },
        "basket_only": {
          "effects": { "ballHeld": false, "ballAt": "basket", "kid": "cheer" },
          "sound": "good",
          "text": {
            "en": "Swish! The ball went in the basket, but the frog is still there. Make it bounce onto the frog!",
            "es": "¡Zas! La pelota entró en la canasta, pero la rana sigue ahí. ¡Haz que rebote sobre la rana!"
          }
        },
        "throw_miss": {
          "effects": { "ballHeld": false, "ballAt": "far", "kid": "shrug" },
          "sound": "bad",
          "text": {
            "en": "Oops! The ball flew into the grass. Throw it through the basket!",
            "es": "¡Uy! La pelota voló a la hierba. ¡Lánzala a través de la canasta!"
          }
        },
        "win": {
          "effects": { "ballHeld": false, "ballAt": "frog", "frog": "squashed", "kid": "cheer" },
          "sound": "win",
          "win": true,
          "text": {
            "en": "BOING! The ball bounced out of the basket and smashed the frog. Mission complete!",
            "es": "¡BOING! La pelota rebotó desde la canasta y aplastó a la rana. ¡Misión cumplida!"
          }
        }
      }
    }
  ]
}
